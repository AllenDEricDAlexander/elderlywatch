(text "MODEM_PWRKEY, MODEM_RESET, MODEM_STATUS not allocated." (at 275 64 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "bc9edac0-27a5-5207-99a4-adadfbaf502c"))

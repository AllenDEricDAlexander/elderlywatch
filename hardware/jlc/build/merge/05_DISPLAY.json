", "X": 129.92126, "Y": -196.85039, "Content": "TBD / NO PHYSICAL PIN NUMBERS / NO FOOTPRINT", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 4.33071, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie71", "X": 1023.62205, "Y": -177.16535, "Content": "LCD CONNECTOR PINOUT TBD", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 6.29921, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie72", "X": 1023.62205, "Y": -212.59843, "Content": "Target: 1.69 inch / 240x280 / ST7789-class / 4-wire SPI.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 6.29921, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie73", "X": 1023.62205, "Y": -248.0315, "Content": "LCD_BL is a logic control only; never power LEDs from an ESP GPIO.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 6.29921, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie74", "X": 1023.62205, "Y": -283.46457, "Content": "Backlight LED string voltage/current and driver are TBD.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 6.29921, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie75", "X": 1023.62205, "Y": -318.89764, "Content": "Touch interface is optional and intentionally unallocated.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 6.29921, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie76", "X": 1023.62205, "Y": -354.33071, "Content": "FPC pitch, pin count, mating side and bend radius are unknown.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 6.29921, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie77", "X": 1023.62205, "Y": -389.76378, "Content": "No connector footprint or backlight regulator invented.", "Rotation": 0, "TextColo
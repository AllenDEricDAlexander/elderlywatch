ontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie190", "X": 1082.67717, "Y": -251.9685, "Content": "MODEM_PWRKEY, MODEM_RESET, MODEM_STATUS not allocated.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie191", "X": 1082.67717, "Y": -279.52756, "Content": "Consider reviewed strap use or an I2C GPIO expander.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie192", "X": 1082.67717, "Y": -307.08661, "Content": "Do not silently multiplex pins or replace SOS with I2C input.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie193", "X": 1082.67717, "Y": -334.64567, "Content": "I2S0_DIN/DOUT names are relative to ESP32.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie194", "X": 1082.67717, "Y": -362.20472, "Content": "Modem signals use isolated MCU_* nets until translator is selected.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie195", "X": 1082.67717, "Y": -389.76378, "Content": "No direct 3V3 connection to unknown modem IO voltage.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie196", "X": 1082.67717, "Y": -417.32283, "Content": "No touch controller allocated in this revision.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie421", "X": 98.4252, "Y": -1259.84252, "Content": "PICO integrates RF matching; external pi network is tuning provision per official peripheral schematic, not a guessed chip match.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}, {"PrimitiveId": "ie422", "X": 98.4252, "Y": -1287.40157, "Content": "No boot button on enclosure. ESP_BOOT and ESP_EN go to fixture test points. Do not pull GPIO45 high.", "Rotation": 0, "TextColor": null, "FontName": null, "FontSize": 5.51181, "Bold": false, "Italic": false, "UnderLine": false, "AlignMode": 4}], "polys": []}